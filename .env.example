# Local Postgres connection. Do not commit a real DATABASE_URL.
DATABASE_URL="postgresql://gigledger:replace-me@localhost:5432/gigledger?schema=public"

# The Vite origin allowed to call the API during local development.
CLIENT_ORIGIN="http://localhost:5173"

# API listener port. Use a different port from Vite.
PORT=3001

# Vite exposes only variables prefixed with VITE_.
VITE_API_URL="http://localhost:3001"

# For production Vercel/Railway deployments set NODE_ENV=production and
# COOKIE_SAME_SITE="none". Local development uses the secure default: lax.
